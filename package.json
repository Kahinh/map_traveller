{
  "name": "map-traveller",
  "private": true,
  "version": "1.0.0",
  "description": "Application Windows flottante qui copie des commandes /travel dans le presse-papiers.",
  "type": "module",
  "scripts": {
    "help": "node scripts/help.mjs",
    "dev": "vite",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:full": "npm run check && npm run build && node scripts/bundle-budget.mjs",
    "ci:watch": "node scripts/ci-watch.mjs",
    "bench:palette": "vitest run -c bench/vitest.config.ts --silent=false",
    "context": "node scripts/context.mjs",
    "tauri": "tauri",
    "version:set": "node scripts/version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tauri-apps/cli": "^2.12.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
