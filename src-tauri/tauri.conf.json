{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapTraveller",
  "mainBinaryName": "MapTraveller",
  "version": "0.1.1",
  "identifier": "app.maptraveller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Map Traveller",
        "width": 510,
        "height": 300,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/MapTraveller/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Copie rapide de commandes /travel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/catalog.seed.json": "resources/catalog.seed.json"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
