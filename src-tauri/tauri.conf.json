{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapTraveller",
  "mainBinaryName": "MapTraveller",
  "version": "0.5.0",
  "identifier": "app.maptraveller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Map Traveller",
        "width": 510,
        "height": 300,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": true,
        "center": true
      },
      {
        "label": "palette",
        "create": false,
        "url": "palette.html",
        "title": "Map Traveller · Palette",
        "width": 560,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "transparent": false,
        "backgroundColor": "#252739"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/MapTraveller/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "createUpdaterArtifacts": false,
    "shortDescription": "Copie rapide de commandes /travel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/catalog.seed.json": "resources/catalog.seed.json"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyODE4QTNERDhDMTI3MkQKUldRdEo4SFlQWXFCUWhqUDd2RFZWTDY0SWtnVWZzbE9JaUhURU51ci9vcnpucUUxTXhucDhvT2cK",
      "endpoints": ["https://github.com/Kahinh/map_traveller/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
